# TrustVault Environment Configuration Example
# Copy this file to .env and configure values for your environment

# Server Port
PORT=3000

# Environment: development | production | test
NODE_ENV=development

# Session Secret (must be a strong, cryptographically secure random string in production)
SESSION_SECRET=your_long_random_session_secret_change_in_production

# Database Directory (relative to project root or absolute)
DATA_DIR=data

# Storage Directory for Private Files (outside public directory)
STORAGE_DIR=storage
