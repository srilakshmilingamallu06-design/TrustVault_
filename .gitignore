# Dependencies
node_modules/

# Environment files containing secrets
.env
.env.local
.env.*.local

# Runtime Database files (exclude actual databases, preserve directory structure)
data/*.db
data/*.db-*
data/*.sqlite*
!data/.gitkeep

# Private storage files (exclude uploaded user documents, preserve directory structure)
storage/*
!storage/.gitkeep

# Automated test temp directories
tests/temp/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System and Editor artifacts
.DS_Store
Thumbs.db
ehthumbs.db
.vscode/
.idea/
*.swp
*.swo
